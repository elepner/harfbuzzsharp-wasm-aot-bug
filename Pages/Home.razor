

@page "/"
@using SkiaSharp

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>


Welcome to your new app.

@code{

    

    protected override void OnInitialized()
    {
        var shaper = new SkiaSharp.HarfBuzz.SKShaper(SKTypeface.Default);
        var result = shaper.Shape("Hello world", new SKPaint()
        {
            Typeface = SKTypeface.Default,
            TextSize = 42
        });

        var w = result.Width;
        Console.WriteLine($"Width: {w}");
    }
}